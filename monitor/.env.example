# Copie para .env (cp .env.example .env) e preencha. O .env NÃO vai para o git.

# ===== WhatsApp via CallMeBot (grátis) =====
# 1) Em https://www.callmebot.com/blog/free-api-whatsapp-messages/ pegue o número atual do bot
# 2) Salve o número nos contatos e mande pelo WhatsApp: I allow callmebot to send me messages
# 3) O bot responde com sua APIKEY. Formato: +55DDDNUMERO:APIKEY (vários separados por vírgula)
WHATSAPP_TO=+5511999998888:1234567
# Nível mínimo para mandar no WhatsApp: CRITICO | ALTO | MEDIO
WHATSAPP_MIN_LEVEL=ALTO

# ===== WhatsApp via Twilio (alternativa/redundância, opcional) =====
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_TO=+5511999998888

# ===== E-mail (Gmail) =====
# Precisa de verificação em 2 etapas e de uma "senha de app": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
EMAIL_TO=seuemail@gmail.com
EMAIL_MIN_LEVEL=MEDIO

# ===== Push no celular via app ntfy (opcional, mas é o aviso mais rápido) =====
# Instale o app ntfy e assine o MESMO tópico. Use um nome difícil de adivinhar.
NTFY_TOPIC=
NTFY_MIN_LEVEL=MEDIO

# ===== Avançado =====
# HEADLESS=false     # abre o navegador visível (ajuda se o site bloquear robôs)
# PAGE_CONCURRENCY=2
